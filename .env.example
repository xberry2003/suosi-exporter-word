TB_APP_ID=
TB_APP_SECRET=
TB_ORG_ID=
TB_OPERATOR_ID=
TB_API_BASE=https://open.teambition.com/api

# Thoughts browser-session renewal. Keep real values in the server secret store,
# never in this file, browser form fields, or the job database.
TEAMBITION_LOGIN_USERNAME=
TEAMBITION_LOGIN_PASSWORD=
# Optional long-running Chromium CDP endpoint. Keep it bound to loopback.
TEAMBITION_CDP_URL=http://127.0.0.1:9222
TEAMBITION_AUTH_URL=http://127.0.0.1:9881

# TB task collector (MCP). Keep the token only in the server environment.
TEAMBITION_MCP_HOST=
TEAMBITION_MCP_TOKEN=

# Employee login service. In production set AUTH_SESSION_SECRET to a unique,
# random 32+ character value in the deployment secret store.
AUTH_API_BASE_URL=http://43.142.31.198:9999/emp/api
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=false

# Team usage tracking. Keep disabled until production enablement is approved.
SUOSI_USAGE_TRACKING_ENABLED=false
SUOSI_USAGE_API_BASE_URL=http://127.0.0.1:18792/api
SUOSI_USAGE_PRODUCT_ID=
SUOSI_USAGE_SOURCE=suosi-control
SUOSI_USAGE_TIMEOUT_MS=3000
